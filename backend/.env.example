# Backend process configuration; loaded by the development command.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Three distinct restricted login URLs; never use postgres/service_role here.
QUERY_DATABASE_URL=
IMPORT_DATABASE_URL=
DEMO_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Groq key may also live in root .env; only these Groq settings fall back there.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Explicit opt-in, metadata only. Raw prompts/results/SQL are never traced.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
